[Unit]
Description=callscribe: log which apps capture audio (no audio is read)
After=pipewire-pulse.service

[Service]
ExecStart=%h/.local/bin/callscribe log-mic
# pactl subscribe ends when PipeWire restarts (an error exit): come back against the new server.
# Quit in the tray menu exits cleanly and stays quit.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
